<header class="page-header">
  <div class="page-header__copy">
    <p class="eyebrow">Temukan kesempatan</p>
    <h1>Kegiatan Relawan</h1>
    <p class="lead">
      Cari kegiatan yang sesuai dengan minat, lokasi, dan waktu Anda.
    </p>
  </div>

  <% if logged_in? && current_user.organization? %>
    <%= link_to "Buat kegiatan", new_volunteer_event_path, class: "button" %>
  <% end %>
</header>

<% content_for :title, "Kegiatan Relawan" %>

<% if logged_in? && current_user.organization? %>
  <section class="panel">
    <p class="eyebrow">Workspace organisasi</p>
    <h2>Kegiatan organisasi Anda</h2>

    <% if @owned_events.any? %>
      <ul class="list-clean">
        <% @owned_events.each do |event| %>
          <li class="list-item">
            <div>
              <%= link_to event.title, event %>
              <div class="text-muted"><%= l event.starts_at, format: :long %></div>
            </div>
            <%= status_badge(event) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="empty-state">
        <h3>Belum ada kegiatan</h3>
        <p>Mulai buat kesempatan relawan pertama untuk organisasi Anda.</p>
        <%= link_to "Buat kegiatan baru", new_volunteer_event_path, class: "button" %>
      </div>
    <% end %>
  </section>
<% end %>

<section>
  <div class="page-header">
    <div>
      <p class="eyebrow">Jelajahi</p>
      <h2>Kegiatan yang akan datang</h2>
    </div>
    <p class="results-count"><%= @total_count %> kegiatan ditemukan</p>
  </div>

  <%= form_with url: volunteer_events_path,
                method: :get,
                class: "filter-panel panel" do |form| %>
    <div class="filter-grid">
      <div class="field">
        <%= form.label :query, "Cari kegiatan" %>
        <%= form.search_field :query,
                              value: params[:query],
                              placeholder: "Judul atau deskripsi" %>
      </div>
      <div class="field">
        <%= form.label :category, "Kategori" %>
        <%= form.select :category,
                        options_for_select(@categories, params[:category]),
                        { include_blank: "Semua kategori" } %>
      </div>
      <div class="field">
        <%= form.label :location, "Lokasi" %>
        <%= form.search_field :location,
                              value: params[:location],
                              placeholder: "Kota atau tempat" %>
      </div>
      <div class="field">
        <%= form.label :date, "Tanggal mulai" %>
        <%= form.date_field :date, value: params[:date] %>
      </div>
    </div>

    <div class="filter-actions">
      <%= form.submit "Terapkan filter" %>
      <%= link_to "Reset", volunteer_events_path, class: "button button--secondary" %>
    </div>
  <% end %>

  <% if @events.any? %>
    <div class="event-grid">
      <% @events.each do |event| %>
        <article class="event-card card">
          <div class="event-card__top">
            <span class="badge"><%= event.category %></span>
            <span class="text-muted"><%= event.capacity %> kapasitas</span>
          </div>

          <h3><%= link_to event.title, event %></h3>
          <p class="text-muted"><%= truncate(event.description, length: 110) %></p>

          <div class="event-card__meta">
            <span><strong>Organisasi:</strong> <%= event.organization.name %></span>
            <span><strong>Lokasi:</strong> <%= event.location %></span>
            <span><strong>Mulai:</strong> <%= l event.starts_at, format: :long %></span>
          </div>
        </article>
      <% end %>
    </div>

    <% if @total_pages > 1 %>
      <nav class="pagination" aria-label="Halaman kegiatan">
        <% if @page > 1 %>
          <%= link_to "← Sebelumnya",
                      volunteer_events_path(request.query_parameters.merge(page: @page - 1)),
                      class: "button button--secondary",
                      rel: "prev" %>
        <% end %>
        <span class="text-muted">Halaman <%= @page %> dari <%= @total_pages %></span>
        <% if @page < @total_pages %>
          <%= link_to "Berikutnya →",
                      volunteer_events_path(request.query_parameters.merge(page: @page + 1)),
                      class: "button button--secondary",
                      rel: "next" %>
        <% end %>
      </nav>
    <% end %>
  <% else %>
    <div class="empty-state">
      <h3>Tidak ada kegiatan ditemukan</h3>
      <p>Coba ubah kata kunci atau reset filter pencarian Anda.</p>
      <%= link_to "Reset filter", volunteer_events_path, class: "button button--secondary" %>
    </div>
  <% end %>
</section>

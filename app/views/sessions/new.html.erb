<% content_for :title, "Masuk" %>

<section class="auth-shell">
  <div class="auth-intro">
    <p class="eyebrow">Selamat datang kembali</p>
    <h2>Aksi kecil hari ini bisa menjadi perubahan besar.</h2>
    <p class="lead">
      Masuk untuk melanjutkan kontribusi, mengecek status pendaftaran,
      atau mengelola kegiatan organisasi Anda.
    </p>
    <ul class="auth-benefits">
      <li>Semua kegiatan tersimpan rapi</li>
      <li>Status pendaftaran mudah dipantau</li>
      <li>Data akun terlindungi dengan aman</li>
    </ul>
  </div>

  <div class="auth-card card">
    <p class="eyebrow">Akses akun</p>
    <h1>Masuk ke VolunteerMatch</h1>
    <p class="text-muted">Gunakan email dan password yang sudah terdaftar.</p>

    <%= form_with url: login_path, scope: :session, class: "form-stack" do |form| %>
      <div class="field">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email, autocomplete: "email", required: true %>
      </div>

      <div class="field">
        <%= form.label :password, "Password" %>
        <%= form.password_field :password,
                                autocomplete: "current-password",
                                required: true %>
      </div>

      <%= form.submit "Masuk", class: "button--block" %>
    <% end %>

    <p class="form-footer">
      <%= link_to "Lupa password?", new_password_reset_path %>
      ·
      <%= link_to "Kirim ulang email konfirmasi", new_email_confirmation_path %>
    </p>

    <p class="form-footer">
      Belum memiliki akun? <%= link_to "Daftar sekarang", new_user_path %>
    </p>
  </div>
</section>

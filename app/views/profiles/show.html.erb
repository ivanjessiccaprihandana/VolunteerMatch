<h1>Profil <%= current_user.organization? ? "Organisasi" : "Relawan" %></h1>

<% if current_user.volunteer? %>
  <dl>
    <dt>Nama</dt>
    <dd><%= current_user.name %></dd>

    <dt>Kota</dt>
    <dd><%= @profile.city.presence || "Belum diisi" %></dd>

    <dt>Telepon</dt>
    <dd><%= @profile.phone.presence || "Belum diisi" %></dd>

    <dt>Keahlian</dt>
    <dd><%= @profile.skills.presence || "Belum diisi" %></dd>

    <dt>Ketersediaan</dt>
    <dd><%= @profile.availability.presence || "Belum diisi" %></dd>

    <dt>Bio</dt>
    <dd><%= @profile.bio.presence || "Belum diisi" %></dd>
  </dl>
<% else %>
  <dl>
    <dt>Nama organisasi</dt>
    <dd><%= @profile.organization_name.presence || "Belum diisi" %></dd>

    <dt>Kota</dt>
    <dd><%= @profile.city.presence || "Belum diisi" %></dd>

    <dt>Telepon</dt>
    <dd><%= @profile.phone.presence || "Belum diisi" %></dd>

    <dt>Website</dt>
    <dd><%= @profile.website.presence || "Belum diisi" %></dd>

    <dt>Deskripsi</dt>
    <dd><%= @profile.description.presence || "Belum diisi" %></dd>

    <dt>Status verifikasi</dt>
    <dd><%= @profile.verified? ? "Terverifikasi" : "Belum terverifikasi" %></dd>
  </dl>
<% end %>

<p><%= link_to "Edit profil", edit_profile_path %></p>
<p><%= link_to "Kembali ke dashboard", dashboard_path %></p>

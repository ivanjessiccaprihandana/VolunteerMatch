<% if event.errors.any? %>
  <section class="error-summary">
    <h2>Kegiatan belum dapat disimpan:</h2>
    <ul>
      <% event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= form_with model: event, class: "form-grid" do |form| %>
  <div class="field field--full">
    <%= form.label :title, "Nama kegiatan" %>
    <%= form.text_field :title,
                        required: true,
                        placeholder: "Contoh: Bersih Pantai Bersama" %>
  </div>

  <div class="field field--full">
    <%= form.label :description, "Deskripsi" %>
    <%= form.text_area :description,
                       required: true,
                       placeholder: "Jelaskan tujuan dan aktivitas kegiatan" %>
  </div>

  <div class="field">
    <%= form.label :category, "Kategori" %>
    <%= form.select :category,
                    VolunteerEvent::CATEGORIES,
                    { include_blank: "Pilih kategori" },
                    required: true %>
  </div>

  <div class="field">
    <%= form.label :location, "Lokasi" %>
    <%= form.text_field :location, required: true, placeholder: "Jakarta" %>
  </div>

  <div class="field">
    <%= form.label :starts_at, "Waktu mulai" %>
    <%= form.datetime_local_field :starts_at, required: true %>
  </div>

  <div class="field">
    <%= form.label :ends_at, "Waktu selesai" %>
    <%= form.datetime_local_field :ends_at, required: true %>
  </div>

  <div class="field">
    <%= form.label :registration_deadline, "Batas pendaftaran" %>
    <%= form.datetime_local_field :registration_deadline, required: true %>
  </div>

  <div class="field">
    <%= form.label :capacity, "Kapasitas relawan" %>
    <%= form.number_field :capacity, min: 1, required: true %>
  </div>

  <div class="field field--full">
    <%= form.label :status, "Status publikasi" %>
    <%= form.select :status,
                    status_options_for(VolunteerEvent) %>
    <% unless current_user.verified_organization? %>
      <small>Organisasi Anda belum diverifikasi, jadi kegiatan hanya bisa disimpan sebagai draf.</small>
    <% end %>
    <% if event.persisted? && !event.cancelled? && event.event_registrations.active.exists? %>
      <small>Mengubah status menjadi <strong>Dibatalkan</strong> akan mengirim email pemberitahuan ke semua relawan yang terdaftar.</small>
    <% end %>
  </div>

  <div class="field field--full">
    <%= form.submit event.persisted? ? "Simpan perubahan" : "Buat kegiatan" %>
  </div>
<% end %>

<!DOCTYPE html>
<html>
  <head>
    <title>VolunteerMatch</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="site-nav container" aria-label="Navigasi utama">
        <%= link_to(logged_in? ? dashboard_path : root_path, class: "brand") do %>
          <span class="brand__mark" aria-hidden="true">VM</span>
          <span>VolunteerMatch</span>
        <% end %>

        <div class="nav-links">
          <%= link_to "Kegiatan", volunteer_events_path, class: "nav-link" %>

          <% if logged_in? %>
            <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
            <%= link_to "Profil", profile_path, class: "nav-link" %>
            <%= button_to "Keluar",
                          logout_path,
                          method: :delete,
                          class: "nav-link" %>
          <% else %>
            <%= link_to "Masuk", login_path, class: "nav-link" %>
            <%= link_to "Daftar", new_user_path, class: "button" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="site-main container">
      <% flash.each do |type, message| %>
        <p class="flash <%= "flash--alert" if type == "alert" %>"
           role="<%= type == "alert" ? "alert" : "status" %>">
          <%= message %>
        </p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner container">
        <span>VolunteerMatch — menghubungkan aksi baik dengan orang yang tepat.</span>
        <span>&copy; <%= Time.current.year %> VolunteerMatch</span>
      </div>
    </footer>
  </body>
</html>

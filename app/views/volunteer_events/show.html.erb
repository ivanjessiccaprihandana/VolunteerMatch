<% content_for :title, @event.title %>

<header class="page-header">
  <div class="page-header__copy">
    <p class="eyebrow"><%= @event.category %></p>
    <h1><%= @event.title %></h1>
    <p class="lead">
      Diselenggarakan oleh <%= @event.organization.organization_profile&.organization_name.presence || @event.organization.name %>
      <% if @event.organization.verified_organization? %>
        <span class="badge" title="Organisasi telah diverifikasi admin VolunteerMatch">✓ Terverifikasi</span>
      <% end %>
    </p>
  </div>
  <%= status_badge(@event) %>
</header>

<div class="event-detail">
  <div>
    <section class="panel">
      <p class="eyebrow">Tentang kegiatan</p>
      <h2>Deskripsi</h2>
      <%= simple_format @event.description %>
    </section>

    <% if logged_in? && @event.organization == current_user %>
      <section class="panel">
        <div class="page-header">
          <div>
            <p class="eyebrow">Manajemen relawan</p>
            <h2>Daftar Pendaftar</h2>
          </div>
        </div>

        <% if @event_registrations.any? %>
          <% @event_registrations.each do |registration| %>
            <article class="application-card">
              <div class="application-card__header">
                <h3><%= registration.volunteer.name %></h3>
                <%= status_badge(registration) %>
              </div>
              <p><strong>Motivasi:</strong> <%= registration.motivation %></p>
              <% if registration.accepted? %>
                <p><strong>Email:</strong> <%= mail_to registration.volunteer.email %></p>
                <% if registration.volunteer.volunteer_profile&.phone.present? %>
                  <p><strong>Telepon:</strong> <%= registration.volunteer.volunteer_profile.phone %></p>
                <% end %>
              <% elsif registration.pending? %>
                <p class="text-muted">Kontak relawan akan terlihat setelah pendaftaran diterima.</p>
              <% end %>

              <% if registration.pending? %>
                <div class="actions">
                  <%= button_to "Terima",
                                accept_volunteer_event_event_registration_path(
                                  @event,
                                  registration
                                ),
                                method: :patch %>
                  <%= button_to "Tolak",
                                reject_volunteer_event_event_registration_path(
                                  @event,
                                  registration
                                ),
                                method: :patch,
                                class: "button--danger" %>
                </div>
              <% end %>
            </article>
          <% end %>
        <% else %>
          <div class="empty-state">
            <h3>Belum ada pendaftar</h3>
            <p>Pendaftar baru akan muncul di bagian ini.</p>
          </div>
        <% end %>
      </section>
    <% elsif logged_in? && current_user.volunteer? %>
      <section class="panel">
        <p class="eyebrow">Ambil bagian</p>
        <h2>Pendaftaran Relawan</h2>

        <% if @event_registration.persisted? %>
          <div class="application-card">
            <div class="application-card__header">
              <strong>Status pendaftaran Anda</strong>
              <%= status_badge(@event_registration) %>
            </div>
            <p><strong>Motivasi:</strong> <%= @event_registration.motivation %></p>

            <% if @event.cancelled? %>
              <div class="empty-state">
                <h3>Kegiatan dibatalkan</h3>
                <p>Penyelenggara telah membatalkan kegiatan ini. Terima kasih atas kesediaan Anda.</p>
              </div>
            <% end %>

            <% if @event_registration.cancellable? %>
              <%= button_to "Batalkan pendaftaran",
                            cancel_volunteer_event_event_registration_path(
                              @event,
                              @event_registration
                            ),
                            method: :patch,
                            class: "button--danger",
                            form: {
                              data: {
                                turbo_confirm: "Yakin ingin membatalkan pendaftaran?"
                              }
                            } %>
            <% end %>
          </div>
        <% elsif @event.registration_open? %>
          <%= form_with model: [@event, @event_registration], class: "form-stack" do |form| %>
            <div class="field">
              <%= form.label :motivation, "Alasan ingin mengikuti kegiatan" %>
              <%= form.text_area :motivation,
                                 required: true,
                                 maxlength: 1_000,
                                 placeholder: "Ceritakan motivasi dan kontribusi yang ingin Anda berikan" %>
            </div>
            <%= form.submit "Daftar sebagai relawan" %>
          <% end %>
        <% else %>
          <div class="empty-state">
            <% if @event.cancelled? %>
              <h3>Kegiatan dibatalkan</h3>
              <p>Penyelenggara telah membatalkan kegiatan ini.</p>
            <% else %>
              <h3>Pendaftaran ditutup</h3>
              <p>Kapasitas penuh atau batas pendaftaran telah berakhir.</p>
            <% end %>
          </div>
        <% end %>
      </section>
    <% elsif !logged_in? && @event.registration_open? %>
      <section class="panel">
        <h2>Ingin mengikuti kegiatan ini?</h2>
        <p class="text-muted">Masuk sebagai relawan untuk mengirim pendaftaran.</p>
        <%= link_to "Masuk untuk mendaftar", login_path, class: "button" %>
      </section>
    <% end %>
  </div>

  <aside class="event-detail__sidebar">
    <section class="panel">
      <p class="eyebrow">Informasi kegiatan</p>
      <dl class="info-grid">
        <div><dt>Lokasi</dt><dd><%= @event.location %></dd></div>
        <div><dt>Mulai</dt><dd><%= l @event.starts_at, format: :long %></dd></div>
        <div><dt>Selesai</dt><dd><%= l @event.ends_at, format: :long %></dd></div>
        <div><dt>Batas daftar</dt><dd><%= l @event.registration_deadline, format: :long %></dd></div>
        <div><dt>Kapasitas</dt><dd><%= @event.capacity %> relawan</dd></div>
        <div><dt>Sisa slot</dt><dd><%= @event.remaining_capacity %> relawan</dd></div>
      </dl>

      <% if logged_in? && @event.organization == current_user %>
        <div class="actions actions--spaced">
          <%= link_to "Edit", edit_volunteer_event_path(@event), class: "button" %>
          <% if @event.deletable? %>
          <%= button_to "Hapus",
                        @event,
                        method: :delete,
                        class: "button--danger",
                        form: {
                          data: {
                            turbo_confirm: "Yakin ingin menghapus kegiatan ini?"
                          }
                        } %>
          <% end %>
        </div>
        <% unless @event.deletable? || @event.cancelled? %>
          <p class="text-muted">
            Kegiatan ini sudah memiliki pendaftar sehingga tidak bisa dihapus.
            Untuk membatalkannya, ubah status menjadi <strong>Dibatalkan</strong> lewat tombol Edit.
          </p>
        <% end %>
      <% end %>
    </section>

    <%= link_to "← Kembali ke daftar kegiatan", volunteer_events_path %>
  </aside>
</div>

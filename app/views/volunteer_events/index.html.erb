<h1>Kegiatan Relawan</h1>

<p><%= link_to "Kembali ke dashboard", dashboard_path if logged_in? %></p>

<% if logged_in? && current_user.organization? %>
  <section>
    <h2>Kegiatan organisasi Anda</h2>
    <p><%= link_to "Buat kegiatan baru", new_volunteer_event_path %></p>

    <% if @owned_events.any? %>
      <ul>
        <% @owned_events.each do |event| %>
          <li>
            <%= link_to event.title, event %>
            — <%= event.status.humanize %>
            — <%= l event.starts_at, format: :long %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>Organisasi Anda belum membuat kegiatan.</p>
    <% end %>
  </section>
<% end %>

<section>
  <h2>Kegiatan yang akan datang</h2>

  <%= form_with url: volunteer_events_path, method: :get do |form| %>
    <div>
      <%= form.label :query, "Cari kegiatan" %>
      <%= form.search_field :query,
                            value: params[:query],
                            placeholder: "Judul atau deskripsi" %>
    </div>

    <div>
      <%= form.label :category, "Kategori" %>
      <%= form.select :category,
                      options_for_select(@categories, params[:category]),
                      { include_blank: "Semua kategori" } %>
    </div>

    <div>
      <%= form.label :location, "Lokasi" %>
      <%= form.search_field :location,
                            value: params[:location],
                            placeholder: "Kota atau tempat" %>
    </div>

    <div>
      <%= form.label :date, "Tanggal mulai" %>
      <%= form.date_field :date, value: params[:date] %>
    </div>

    <%= form.submit "Terapkan filter" %>
    <%= link_to "Reset filter", volunteer_events_path %>
  <% end %>

  <p><%= @events.size %> kegiatan ditemukan.</p>

  <% if @events.any? %>
    <% @events.each do |event| %>
      <article>
        <h3><%= link_to event.title, event %></h3>
        <p><strong>Organisasi:</strong> <%= event.organization.name %></p>
        <p><strong>Kategori:</strong> <%= event.category %></p>
        <p><strong>Lokasi:</strong> <%= event.location %></p>
        <p><strong>Mulai:</strong> <%= l event.starts_at, format: :long %></p>
      </article>
    <% end %>
  <% else %>
    <p>Tidak ada kegiatan yang sesuai dengan filter.</p>
  <% end %>
</section>

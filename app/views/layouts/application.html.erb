<!DOCTYPE html>
<html lang="id">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · VolunteerMatch" : "VolunteerMatch — Temukan kegiatan relawan" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="VolunteerMatch mempertemukan relawan dengan organisasi penyelenggara kegiatan sosial di Indonesia.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="site-nav container" aria-label="Navigasi utama">
        <%= link_to(logged_in? ? dashboard_path : root_path, class: "brand") do %>
          <span class="brand__mark" aria-hidden="true">VM</span>
          <span>VolunteerMatch</span>
        <% end %>

        <div class="nav-links">
          <%= link_to "Kegiatan", volunteer_events_path, class: "nav-link" %>

          <% if logged_in? %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path, class: "nav-link" %>
            <% end %>
            <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
            <% unless current_user.admin? %>
              <%= link_to "Profil", profile_path, class: "nav-link" %>
            <% end %>
            <%= button_to "Keluar",
                          logout_path,
                          method: :delete,
                          class: "nav-link" %>
          <% else %>
            <%= link_to "Masuk", login_path, class: "nav-link" %>
            <%= link_to "Daftar", new_user_path, class: "button" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="site-main container">
      <% flash.each do |type, message| %>
        <p class="flash <%= "flash--alert" if type == "alert" %>"
           role="<%= type == "alert" ? "alert" : "status" %>">
          <%= message %>
        </p>
      <% end %>

      <% if logged_in? && current_user.organization? && !current_user.verified_organization? %>
        <p class="notice-banner" role="status">
          Organisasi Anda belum diverifikasi. Anda tetap bisa membuat kegiatan sebagai draf;
          kegiatan dapat dipublikasikan setelah admin memverifikasi
          <%= link_to "profil organisasi", profile_path %> Anda.
        </p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner container">
        <span>VolunteerMatch — menghubungkan aksi baik dengan orang yang tepat.</span>
        <span class="footer-links">
          <%= link_to "Kebijakan Privasi", privacy_path %>
          <%= link_to "Syarat Penggunaan", terms_path %>
          <span>&copy; <%= Time.current.year %> VolunteerMatch</span>
        </span>
      </div>
    </footer>
  </body>
</html>

# Keep secrets, local state, and VCS data out of the image.
/.git/
/.github/
/.bundle
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/node_modules/
/coverage/

/test/
/docs/
/PostgreSQL*
/Dockerfile
/docker-compose.yml
/.dockerignore

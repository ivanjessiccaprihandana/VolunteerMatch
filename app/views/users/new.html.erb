<h1>Daftar sebagai Relawan</h1>

<p>Buat akun untuk mengikuti kegiatan volunteer.</p>

<% if notice.present? %>
  <p><%= notice %></p>
<% end %>

<% if @user.errors.any? %>
  <section>
    <h2>Form belum dapat disimpan:</h2>

    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= form_with model: @user do |form| %>
  <div>
    <%= form.label :name, "Nama lengkap" %>
    <%= form.text_field :name, autocomplete: "name" %>
  </div>

  <div>
    <%= form.label :email, "Email" %>
    <%= form.email_field :email, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, autocomplete: "new-password" %>
    <small>Minimal 8 karakter.</small>
  </div>

  <div>
    <%= form.label :password_confirmation, "Konfirmasi password" %>
    <%= form.password_field :password_confirmation,
                            autocomplete: "new-password" %>
  </div>

  <div>
    <%= form.submit "Buat akun" %>
  </div>
<% end %>
<h1>Masuk ke VolunteerMatch</h1>

<%= form_with url: login_path, scope: :session do |form| %>
  <div>
    <%= form.label :email, "Email" %>
    <%= form.email_field :email, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, autocomplete: "current-password" %>
  </div>

  <div>
    <%= form.submit "Masuk" %>
  </div>
<% end %>

<p>
  Belum memiliki akun?
  <%= link_to "Daftar sebagai relawan", new_user_path %>
</p>

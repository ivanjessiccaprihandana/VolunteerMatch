<header class="page-header">
  <div class="page-header__copy">
    <p class="eyebrow">Perbarui informasi</p>
    <h1>Edit Profil</h1>
    <p class="lead">Informasi yang lengkap membantu membangun kepercayaan.</p>
  </div>
  <%= link_to "Batal", profile_path, class: "button button--secondary" %>
</header>

<section class="panel">
  <% if @profile.errors.any? %>
    <section class="error-summary">
      <h2>Profil belum dapat disimpan:</h2>
      <ul>
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form_with model: @profile,
                url: profile_path,
                method: :patch,
                class: "form-grid" do |form| %>
    <% if current_user.volunteer? %>
      <div class="field">
        <%= form.label :phone, "Nomor telepon" %>
        <%= form.telephone_field :phone, autocomplete: "tel" %>
      </div>
      <div class="field">
        <%= form.label :city, "Kota" %>
        <%= form.text_field :city %>
      </div>
      <div class="field field--full">
        <%= form.label :skills, "Keahlian" %>
        <%= form.text_area :skills %>
      </div>
      <div class="field field--full">
        <%= form.label :availability, "Ketersediaan" %>
        <%= form.text_field :availability %>
      </div>
      <div class="field field--full">
        <%= form.label :bio, "Bio" %>
        <%= form.text_area :bio %>
      </div>
    <% else %>
      <div class="field field--full">
        <%= form.label :organization_name, "Nama organisasi" %>
        <%= form.text_field :organization_name %>
      </div>
      <div class="field">
        <%= form.label :phone, "Nomor telepon" %>
        <%= form.telephone_field :phone, autocomplete: "tel" %>
      </div>
      <div class="field">
        <%= form.label :city, "Kota" %>
        <%= form.text_field :city %>
      </div>
      <div class="field field--full">
        <%= form.label :website, "Website" %>
        <%= form.url_field :website %>
      </div>
      <div class="field field--full">
        <%= form.label :description, "Deskripsi" %>
        <%= form.text_area :description %>
      </div>
    <% end %>

    <div class="field field--full">
      <%= form.submit "Simpan profil" %>
    </div>
  <% end %>
</section>

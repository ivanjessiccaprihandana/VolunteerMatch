# Copy to .env and fill in. Never commit the real .env.

# --- Required -------------------------------------------------------------
# Generate with: bin/rails secret
SECRET_KEY_BASE=
# Public host name(s) of the app, comma separated. Used for email links and
# to block requests for other hosts.
APP_HOST=volunteermatch.example.org
# Database password used by docker-compose.yml.
POSTGRES_PASSWORD=
# Outside docker-compose, set the full connection URL instead:
# DATABASE_URL=postgres://user:password@host:5432/volunteermatch_production

# --- Email (SMTP) ---------------------------------------------------------
# Works with Brevo, Mailgun, SendGrid, Amazon SES, Gmail (app password), etc.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="VolunteerMatch <no-reply@volunteermatch.example.org>"
PRIVACY_CONTACT_EMAIL=privasi@volunteermatch.example.org

# --- Optional -------------------------------------------------------------
# Error monitoring (https://sentry.io). Leave empty to disable.
SENTRY_DSN=
# Puma threads and worker processes.
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
RAILS_LOG_LEVEL=info
# Only for smoke-testing the container over plain HTTP on your machine.
# DISABLE_SSL=true
